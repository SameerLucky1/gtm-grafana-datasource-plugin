{
  "name": "akamai-gtm-datasource-plugin",
  "version": "2.1.0",
  "description": "Grafana datasource for Akamai Global Traffic Management (GTM)  metrics",
  "scripts": {
    "build": "webpack -c ./.config/webpack/webpack.config.ts --env production",
    "dev": "webpack -w -c ./.config/webpack/webpack.config.ts --env development",
    "e2e": "playwright test",
    "lint": "eslint --cache .",
    "lint:fix": "yarn run lint --fix && prettier --write --list-different .",
    "server": "docker compose up --build",
    "sign": "sign-plugin",
    "start": "yarn watch",
    "test": "jest --watch --onlyChanged",
    "test:ci": "jest --passWithNoTests --maxWorkers 4",
    "typecheck": "tsc --noEmit"
  },
  "author": "Steve Vernick",
  "license": "Apache-2.0",
  "devDependencies": {
    "@grafana/eslint-config": "^10.0.0",
    "@grafana/plugin-e2e": "^3.9.1",
    "@grafana/sign-plugin": "^3.2.2",
    "@grafana/tsconfig": "^2.2.0",
    "@playwright/test": "^1.61.1",
    "@stylistic/eslint-plugin-ts": "^4.4.1",
    "@swc/core": "^1.15.43",
    "@swc/helpers": "^0.5.23",
    "@swc/jest": "^0.2.39",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/jest": "^30.0.0",
    "@types/lodash": "latest",
    "@types/node": "^26.0.1",
    "@typescript-eslint/eslint-plugin": "^8.62.0",
    "@typescript-eslint/parser": "^8.62.0",
    "copy-webpack-plugin": "^14.0.0",
    "css-loader": "^7.1.2",
    "eslint": "^10.6.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jsdoc": "^63.0.10",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-webpack-plugin": "^6.0.0",
    "fork-ts-checker-webpack-plugin": "^9.1.0",
    "glob": "^13.0.0",
    "identity-obj-proxy": "^3.0.0",
    "imports-loader": "^5.0.0",
    "jest": "^30.4.2",
    "jest-environment-jsdom": "^30.4.1",
    "prettier": "^3.9.3",
    "replace-in-file-webpack-plugin": "^1.0.6",
    "sass": "^1.101.0",
    "sass-loader": "^17.0.0",
    "semver": "^7.8.5",
    "style-loader": "^4.0.0",
    "swc-loader": "^0.2.7",
    "terser-webpack-plugin": "^5.6.1",
    "ts-node": "^10.9.2",
    "typescript": "6.0.3",
    "webpack": "^5.108.2",
    "webpack-cli": "^7.1.0",
    "webpack-livereload-plugin": "^3.0.2",
    "webpack-subresource-integrity": "5.1.0",
    "webpack-virtual-modules": "^0.6.2"
  },
  "resolutions": {
    "rxjs": "7.8.2",
    "@types/react": "18.0.37",
    "@types/react-dom": "18.0.11",
    "js-cookie": ">=3.0.7",
    "dompurify": ">=3.3.2",
    "immutable": ">=5.1.5",
    "glob": "^13.0.6",
    "memfs": "^4.0.0",
    "memoize-one": "^6.0.0",
    "jsdom": "^27.0.0",
    "tiny-lr": "^2.0.0",
    "raw-body": "^2.5.2"
  },
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "@emotion/css": "11.13.5",
    "@grafana/data": "13.1.0",
    "@grafana/i18n": "^13.1.0",
    "@grafana/runtime": "13.1.0",
    "@grafana/schema": "^13.1.0",
    "@grafana/ui": "13.1.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7"
  },
  "packageManager": "yarn@4.17.0"
}
